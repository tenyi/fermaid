<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-architecture" viewBox="0 0 176 64" width="176" height="64" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="architecture"><g transform="translate(8,8)"><g class="fermaid-edges" fill="none" stroke="var(--_l)" stroke-linecap="round" stroke-linejoin="round"><g class="fermaid-edge" data-id="a-b"><path d="M48,24L112,24"/></g></g><g class="fermaid-edge-labels" font-size="14"><g class="fermaid-edge-label" data-id="a-b"><rect x="58.49" y="13.5" width="43.01" height="21" rx="3" fill="var(--_bg)"/><text x="80" y="28.9" text-anchor="middle">reads</text></g></g><g class="fermaid-nodes"><g class="fermaid-node fermaid-service" data-id="a" transform="translate(24,0)" data-icon="server"><rect x="-24" y="0" width="48" height="48" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text class="fermaid-label" x="0" y="29.6" text-anchor="middle">A</text></g><g class="fermaid-node fermaid-service" data-id="b" transform="translate(136,0)" data-icon="server"><rect x="-24" y="0" width="48" height="48" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text class="fermaid-label" x="0" y="29.6" text-anchor="middle">B</text></g></g></g></svg>
