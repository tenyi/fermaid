<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-gitGraph" viewBox="0 0 103 41" width="103" height="41" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="gitGraph"><g transform="translate(74.34,20.5)"><g class="fermaid-branches" fill="none" font-size="14"><g class="fermaid-branch" data-id="main"><path class="fermaid-lane" d="M-20,0L20,0" stroke="var(--fermaid-series-1,#4c78a8)" stroke-dasharray="2 4"/><rect x="-66.34" y="-12.5" width="46.34" height="25" fill="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r)"/><text class="fermaid-label" fill="var(--_bg)" x="-43.17" y="4.9" text-anchor="middle">main</text></g></g><g class="fermaid-commits" font-size="12" fill="var(--_m)"><g class="fermaid-commit fermaid-commit-normal" data-id="abc"><circle cx="0" cy="0" r="7" fill="var(--fermaid-series-1,#4c78a8)"/></g></g></g></svg>
