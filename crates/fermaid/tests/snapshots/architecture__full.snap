<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-architecture" viewBox="0 0 260 120" width="260" height="120" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="architecture"><g transform="translate(8,8)"><g class="fermaid-clusters"><g class="fermaid-cluster" data-id="api"><rect x="0" y="0" width="243.6" height="104" fill="var(--_a)" fill-opacity="0.5" stroke="var(--_b)" style="rx:var(--_r)"/><g class="fermaid-cluster-label" data-icon="cloud"><text class="fermaid-cluster-label" fill="var(--_m)" x="22.9" y="23.6" text-anchor="middle">API</text></g></g></g><g class="fermaid-edges" fill="none" stroke="var(--_l)" stroke-linecap="round" stroke-linejoin="round"><g class="fermaid-edge" data-id="db-server"><path d="M131.12,60L91.12,60"/></g></g><g class="fermaid-nodes"><g class="fermaid-node fermaid-service" data-id="db" transform="translate(177.36,36)" data-icon="database"><rect x="-46.24" y="0" width="92.48" height="48" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text class="fermaid-label" x="0" y="29.6" text-anchor="middle">Database</text></g><g class="fermaid-node fermaid-service" data-id="server" transform="translate(55.56,36)" data-icon="server"><rect x="-35.56" y="0" width="71.12" height="48" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text class="fermaid-label" x="0" y="29.6" text-anchor="middle">Server</text></g></g></g></svg>
