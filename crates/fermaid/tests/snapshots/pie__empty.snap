---
source: crates/fermaid/tests/pie.rs
expression: svg(src)
---
<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-pie" viewBox="0 0 256 256" width="256" height="256" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="pie"><g class="fermaid-slices" transform="translate(128,128)" stroke="var(--_bg)" stroke-width="1" stroke-linejoin="round"><circle class="fermaid-slice" r="120" fill="none" stroke="var(--_b)"/></g></svg>
