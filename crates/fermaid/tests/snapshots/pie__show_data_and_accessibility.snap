source: crates/fermaid/tests/pie.rs
expression: svg(src)
---
<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-pie" viewBox="0 0 484 312" width="484" height="312" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="pie" aria-labelledby="fermaid-title" aria-describedby="fermaid-desc"><title id="fermaid-title">Key elements</title><desc id="fermaid-desc">Elements in the Earth's crust</desc><g class="fermaid-slices" transform="translate(156,156)" stroke="var(--_bg)" stroke-width="1" stroke-linejoin="round"><path class="fermaid-slice" data-id="Calcium" d="M0,0L0,-120A120,120 0 0 1 71.93,96.05Z" fill="var(--fermaid-series-1,#4c78a8)"/><path class="fermaid-slice" data-id="Potassium" d="M0,0L71.93,96.05A120,120 0 0 1 -91.96,-77.1Z" fill="var(--fermaid-series-2,#f58518)"/><path class="fermaid-slice" data-id="Magnesium" d="M0,0L-91.96,-77.1A120,120 0 0 1 -34.41,-114.96Z" fill="var(--fermaid-series-3,#54a24b)"/><path class="fermaid-slice" data-id="Iron" d="M0,0L-34.41,-114.96A120,120 0 0 1 0,-120Z" fill="var(--fermaid-series-4,#e45756)"/></g><g class="fermaid-slice-labels" transform="translate(156,156)" font-size="14" text-anchor="middle" fill="var(--_bg)"><text x="85.39" y="-23.53">40%</text><text x="-65.36" y="66.77">46%</text><text x="-49.47" y="-70.28">9%</text></g><g class="fermaid-slice-labels" transform="translate(156,156)" font-size="14" text-anchor="middle"><text x="-19.42" y="-127.69">5%</text></g><g class="fermaid-legend" font-size="14"><g class="fermaid-legend-item" data-id="Calcium"><rect x="336" y="111" width="12" height="12" rx="2" fill="var(--fermaid-series-1,#4c78a8)"/><text x="404.63" y="121.9" text-anchor="middle">Calcium [42.96]</text></g><g class="fermaid-legend-item" data-id="Potassium"><rect x="336" y="137" width="12" height="12" rx="2" fill="var(--fermaid-series-2,#f58518)"/><text x="412.03" y="147.9" text-anchor="middle">Potassium [50.05]</text></g><g class="fermaid-legend-item" data-id="Magnesium"><rect x="336" y="163" width="12" height="12" rx="2" fill="var(--fermaid-series-3,#54a24b)"/><text x="415.53" y="173.9" text-anchor="middle">Magnesium [10.01]</text></g><g class="fermaid-legend-item" data-id="Iron"><rect x="336" y="189" width="12" height="12" rx="2" fill="var(--fermaid-series-4,#e45756)"/><text x="377.79" y="199.9" text-anchor="middle">Iron [5]</text></g></g></svg>
