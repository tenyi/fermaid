<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-c4" viewBox="0 0 288 216" width="288" height="216" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_hw:var(--fermaid-heading-weight,bold);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="c4"><g transform="translate(8,8)"><g class="fermaid-clusters"><g class="fermaid-cluster fermaid-c4-node" data-id="node1"><rect x="0" y="0" width="272" height="200" fill="none" stroke="var(--_b)" style="rx:var(--_r)"/><text class="fermaid-cluster-label" font-weight="var(--_hw)" x="16" y="27.6" text-anchor="start" xml:space="preserve">Node 1</text><text class="fermaid-c4-type" font-size="13" fill="var(--_m)" x="16" y="48.55" text-anchor="start" xml:space="preserve">[Node]</text></g></g><g class="fermaid-nodes"><g class="fermaid-node fermaid-shape-person fermaid-c4-person" data-id="p" transform="translate(136,126)"><rect x="-108" y="-20" width="216" height="66" rx="12" fill="var(--_s)" stroke="var(--_b)"/><circle cy="-32" r="13" fill="var(--_s)" stroke="var(--_b)"/><text class="fermaid-c4-type" font-size="12" fill="var(--_m)" x="0" y="5.2" text-anchor="middle">«person»</text><text class="fermaid-label" font-weight="var(--_hw)" text-anchor="middle" xml:space="preserve"><tspan x="0" y="27.6">A person</tspan></text></g></g></g></svg>
