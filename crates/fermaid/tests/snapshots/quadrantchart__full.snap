---
source: crates/fermaid/tests/quadrantchart.rs
expression: svg(&src)
---
<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-quadrantChart" viewBox="0 0 500 500" width="500" height="500" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_tw:var(--fermaid-title-weight,bold);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="quadrantChart"><text class="fermaid-title" font-weight="var(--_tw)" text-anchor="middle" xml:space="preserve"><tspan x="250" y="22.6">Reach and engagement of campaigns</tspan></text><g class="fermaid-quadrants" fill="var(--_s)" stroke="var(--_b)"><g class="fermaid-quadrant" data-id="1"><rect x="265" y="42" width="227" height="210" style="rx:var(--_r)"/><text class="fermaid-label" fill="var(--_fg)" stroke="none" x="378.5" y="64.6" text-anchor="middle">We should expand</text></g><g class="fermaid-quadrant" data-id="2"><rect x="34" y="42" width="227" height="210" style="rx:var(--_r)"/><text class="fermaid-label" fill="var(--_fg)" stroke="none" x="147.5" y="64.6" text-anchor="middle">Need to promote</text></g><g class="fermaid-quadrant" data-id="3"><rect x="34" y="256" width="227" height="210" style="rx:var(--_r)"/><text class="fermaid-label" fill="var(--_fg)" stroke="none" x="147.5" y="278.6" text-anchor="middle">Re-evaluate</text></g><g class="fermaid-quadrant" data-id="4"><rect x="265" y="256" width="227" height="210" style="rx:var(--_r)"/><text class="fermaid-label" fill="var(--_fg)" stroke="none" x="378.5" y="278.6" text-anchor="middle">May be improved</text></g></g><g class="fermaid-axis-labels" font-size="14" fill="var(--_m)"><text x="148.5" y="486.4" text-anchor="middle">Low Reach</text><text x="377.5" y="486.4" text-anchor="middle">High Reach</text><g transform="translate(18.5,360) rotate(-90)"><text x="0" y="4.9" text-anchor="middle">Low Engagement</text></g><g transform="translate(18.5,148) rotate(-90)"><text x="0" y="4.9" text-anchor="middle">High Engagement</text></g></g><g class="fermaid-points" fill="var(--fermaid-series-1,#4c78a8)"><circle class="fermaid-point" data-id="Campaign F" cx="194.3" cy="135.28" r="5"/><circle class="fermaid-point" data-id="Campaign E" cx="217.2" cy="321.84" r="5"/><circle class="fermaid-point" data-id="Campaign D" cx="391.24" cy="321.84" r="5"/><circle class="fermaid-point" data-id="Campaign C" cx="295.06" cy="173.44" r="5"/><circle class="fermaid-point" data-id="Campaign B" cx="240.1" cy="368.48" r="5"/><circle class="fermaid-point" data-id="Campaign A" cx="171.4" cy="211.6" r="5"/></g><g class="fermaid-point-labels" font-size="12"><text class="fermaid-label" x="171.4" y="233" text-anchor="middle">Campaign A</text><text class="fermaid-label" x="197.09" y="372.68" text-anchor="middle">Campaign B</text><text class="fermaid-label" x="338.4" y="177.64" text-anchor="middle">Campaign C</text><text class="fermaid-label" x="391.24" y="343.24" text-anchor="middle">Campaign D</text><text class="fermaid-label" x="217.2" y="343.24" text-anchor="middle">Campaign E</text><text class="fermaid-label" x="194.3" y="156.68" text-anchor="middle">Campaign F</text></g></svg>
