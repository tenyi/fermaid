---
source: crates/fermaid/tests/treemap.rs
expression: svg(&src)
---
<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-treemap" viewBox="0 0 656 416" width="656" height="416" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_hw:var(--fermaid-heading-weight,bold);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="treemap"><g class="fermaid-sections" font-size="14"><g class="fermaid-node fermaid-section" data-id="Products"><rect x="8" y="8" width="640" height="400" fill="var(--fermaid-series-1,#4c78a8)" fill-opacity="0.12" stroke="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r)"/><text x="16" y="27.9" font-weight="var(--_hw)">Products</text><text class="fermaid-value" x="640" y="27.2" font-size="12" text-anchor="end" fill="var(--_m)">160</text></g><g class="fermaid-node fermaid-section" data-id="Electronics"><rect x="14" y="36" width="312" height="366" fill="var(--fermaid-series-1,#4c78a8)" fill-opacity="0.12" stroke="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r)"/><text x="22" y="55.9" font-weight="var(--_hw)">Electronics</text><text class="fermaid-value" x="318" y="55.2" font-size="12" text-anchor="end" fill="var(--_m)">80</text></g><g class="fermaid-node fermaid-section" data-id="Clothing"><rect x="330" y="36" width="312" height="366" fill="var(--fermaid-series-1,#4c78a8)" fill-opacity="0.12" stroke="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r)"/><text x="338" y="55.9" font-weight="var(--_hw)">Clothing</text><text class="fermaid-value" x="634" y="55.2" font-size="12" text-anchor="end" fill="var(--_m)">80</text></g></g><g class="fermaid-leaves" text-anchor="middle" fill="var(--_bg)"><g class="fermaid-node fermaid-leaf" data-id="Phones"><rect x="20" y="64" width="300" height="206" fill="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r)"/><text x="170" y="164.48" font-size="16">Phones</text><text class="fermaid-value" x="170" y="181.55" font-size="13">50</text></g><g class="fermaid-node fermaid-leaf" data-id="Computers"><rect x="20" y="274" width="300" height="122" fill="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r)"/><text x="170" y="332.48" font-size="16">Computers</text><text class="fermaid-value" x="170" y="349.55" font-size="13">30</text></g><g class="fermaid-node fermaid-leaf" data-id="Men's"><rect x="336" y="64" width="300" height="164" fill="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r)"/><text x="486" y="143.48" font-size="16">Men's</text><text class="fermaid-value" x="486" y="160.55" font-size="13">40</text></g><g class="fermaid-node fermaid-leaf" data-id="Women's"><rect x="336" y="232" width="300" height="164" fill="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r)"/><text x="486" y="311.48" font-size="16">Women's</text><text class="fermaid-value" x="486" y="328.55" font-size="13">40</text></g></g></svg>
