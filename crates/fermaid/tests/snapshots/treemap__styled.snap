<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-treemap" viewBox="0 0 656 416" width="656" height="416" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_hw:var(--fermaid-heading-weight,bold);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="treemap"><g class="fermaid-sections" font-size="14"><g class="fermaid-node fermaid-section" data-id="Section 2"><rect x="8" y="8" width="416" height="400" fill="var(--fermaid-series-2,#f58518)" fill-opacity="0.12" stroke="var(--fermaid-series-2,#f58518)" style="rx:var(--_r)"/><text x="16" y="27.9" font-weight="var(--_hw)">Section 2</text><text class="fermaid-value" x="416" y="27.2" font-size="12" text-anchor="end" fill="var(--_m)">45</text></g><g class="fermaid-node fermaid-section" data-id="Section 1"><rect x="428" y="8" width="220" height="400" fill="var(--fermaid-series-1,#4c78a8)" fill-opacity="0.12" stroke="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r)"/><text x="436" y="27.9" font-weight="var(--_hw)">Section 1</text><text class="fermaid-value" x="640" y="27.2" font-size="12" text-anchor="end" fill="var(--_m)">24</text></g><g class="fermaid-node fermaid-section class1" data-id="Section 1.2"><rect x="434" y="221" width="208" height="181" fill="var(--fermaid-series-1,#4c78a8)" stroke="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r);fill:red;stroke:#FFD600;"/><text x="442" y="240.9" font-weight="var(--_hw)" style="fill:blue;">Section 1.2</text><text class="fermaid-value" x="634" y="240.2" font-s