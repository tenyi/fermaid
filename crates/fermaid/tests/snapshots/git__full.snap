<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-gitGraph" viewBox="0 0 275 177" width="275" height="177" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="gitGraph"><g transform="translate(93.03,39)"><g class="fermaid-branches" fill="none" font-size="14"><g class="fermaid-branch" data-id="main"><path class="fermaid-lane" d="M-20,0L173.84,0" stroke="var(--fermaid-series-1,#4c78a8)" stroke-dasharray="2 4"/><rect x="-66.34" y="-12.5" width="46.34" height="25" fill="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r)"/><text class="fermaid-label" fill="var(--_bg)" x="-43.17" y="4.9" text-anchor="middle">main</text></g><g class="fermaid-branch" data-id="develop"><path class="fermaid-lane" d="M-20,88.78L173.84,88.78" stroke="var(--fermaid-series-2,#f58518)" stroke-dasharray="2 4"/><rect x="-85.03" y="76.28" width="65.03" height="25" fill="var(--fermaid-series-2,#f58518)" style="rx:var(--_r)"/><text class="fermaid-label" fill="var(--_bg)" x="-52.51" y="93.68" text-anchor="middle">develop</text></g></g><g class="fermaid-edges" fill="none" stroke-width="2" stroke-linecap="round"><path class="fermaid-edge" d="M0,0C18,0 18,88.78 36,88.78L64.5,88.78" stroke="var(--fermaid-series-2,#f58518)"/><path class="fermaid-edge fermaid-edge-merge" d="M64.5,88.78L73.84,88.78C91.84,88.78 91.84,0 109.84,0" stroke="var(--fermaid-series-2,#f58518)"/><path class="fermaid-edge" d="M0,0L109.84,0" stroke="var(--fermaid-series-1,#4