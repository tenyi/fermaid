<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-railroad" viewBox="0 0 152 156" width="152" height="156" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_hw:var(--fermaid-heading-weight,bold);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="railroad"><g class="fermaid-rules" transform="translate(0.5,0.5)" font-size="14" text-anchor="middle"><g class="fermaid-rule" data-id="r"><text class="fermaid-rule-name" x="8" y="25.6" font-size="16" font-weight="var(--_hw)" text-anchor="start">r</text><path class="fermaid-edge fermaid-track" d="M16,53H28M124,53H136M28,53H59M93,53H124M38,83a10,10 0 0 0 10,10H55M97,93H104a10,10 0 0 0 10,-10M28,53a10,10 0 0 1 10,10V123a10,10 0 0 0 10,10M104,133a10,10 0 0 0 10,-10V63a10,10 0 0 1 10,-10" fill="none" stroke="var(--_l)"/><circle class="fermaid-marker fermaid-start" cx="12" cy="53" r="4" fill="var(--_l)"/><circle class="fermaid-marker fermaid-end" cx="140" cy="53" r="4" fill="var(--_l)"/><g class="fermaid-node fermaid-terminal"><rect x="59" y="38" width="34" height="30" rx="15" fill="var(--_s)" stroke="var(--_b)"/><text x="76" y="57.9" font-family="var(--_fm)">a</text></g><g class="fermaid-node fermaid-terminal"><rect x="55" y="78" width="42" height="30" rx="15" fill="var(--_s)" stroke="var(--_b)"/><text x="76" y="97.9" font-family="var(--_fm)">bb</text></g><g class="fermaid-node fermaid-special"><rect x="48" y="118" width="56" height="30" fill="var(--_bg)" stroke="var(--_b)" stroke-dasharray="4 3" style="rx:var(--_r)"/><text x="76" y="137.9" font-style="italic"><tspan fill="var(--_m)">? </tspan>x<tspan fill="var(--_m)"> ?</tspan></text></g></g></g></svg>
