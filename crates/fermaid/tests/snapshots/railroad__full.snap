<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-railroad" viewBox="0 0 228 254" width="228" height="254" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_tw:var(--fermaid-title-weight,bold);--_hw:var(--fermaid-heading-weight,bold);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="railroad"><text class="fermaid-title" font-weight="var(--_tw)" text-anchor="middle" xml:space="preserve"><tspan x="114" y="25.6">A grammar</tspan></text><g class="fermaid-rules" transform="translate(0.5,0.5)" font-size="14" text-anchor="middle"><g class="fermaid-rule" data-id="rule"><text class="fermaid-rule-name" x="8" y="65.6" font-size="16" font-weight="var(--_hw)" text-anchor="start">rule</text><path class="fermaid-edge fermaid-track" d="M16,103H28M200,103H212M110,103H126M62,103H78M126,103H146M180,103H200M126,103a10,10 0 0 0 10,-10V88a10,10 0 0 1 10,-10H180a10,10 0 0 1 10,10V93a10,10 0 0 0 10,10" fill="none" stroke="var(--_l)"/><circle class="fermaid-marker fermaid-start" cx="12" cy="103" r="4" fill="var(--_l)"/><circle class="fermaid-marker fermaid-end" cx="216" cy="103" r="4" fill="var(--_l)"/><g class="fermaid-node fermaid-terminal"><rect x="28" y="88" width="34" height="30" rx="15" fill="var(--_s)" stroke="var(--_b)"/><text x="45" y="107.9" font-family="var(--_fm)">a</text></g><g class="fermaid-node fermaid-nonterminal" data-id="b"><rect x="78" y="88" width="32" height="30" fill="var(--_bg)" stroke="var(--_b)" style="rx:var(--_r)"/><text x="94" y="107.9">b</text