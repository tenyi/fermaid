source: crates/fermaid/tests/packet.rs
expression: svg(&src)
---
<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-packet" viewBox="0 0 1035 113" width="1035" height="113" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="packet"><g class="fermaid-packet-fields" font-size="14" text-anchor="middle"><g class="fermaid-node" data-id="0-15"><rect x="8" y="22" width="507" height="32" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text x="261.5" y="42.9">Source Port</text></g><g class="fermaid-node" data-id="16-31"><rect x="520" y="22" width="507" height="32" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text x="773.5" y="42.9">Destination Port</text></g><g class="fermaid-node" data-id="32-63"><rect x="8" y="73" width="1019" height="32" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text x="517.5" y="93.9">Sequence Number</text></g></g><g class="fermaid-packet-bits" font-size="10" fill="var(--_m)"><text x="8" y="18">0</text><text x="515" y="18" text-anchor="end">15</text><text x="520" y="18">16</text><text x="1027" y="18" text-anchor="end">31</text><text x="8" y="69">32</text><text x="1027" y="69" text-anchor="end">63</text></g></svg>
