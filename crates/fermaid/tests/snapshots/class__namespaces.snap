<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-class" viewBox="0 0 143 554" width="143" height="554" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_hw:var(--fermaid-heading-weight,bold);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="class"><g class="fermaid-clusters"><g class="fermaid-cluster fermaid-namespace" data-id="Shop"><rect x="8" y="249" width="126.72" height="297" fill="var(--_a)" fill-opacity="0.5" stroke="var(--_b)" style="rx:var(--_r)"/><text class="fermaid-cluster-label" fill="var(--_m)" x="40.68" y="274.6" text-anchor="middle">Shop</text></g></g><g class="fermaid-edges" fill="none" stroke="var(--_l)" stroke-linecap="round"><g class="fermaid-edge fermaid-note-edge" data-id="edgeNote0"><path d="M71.36,45L71.36,117" stroke-dasharray="2 4"/></g><g class="fermaid-edge fermaid-relation" data-id="id_Order_Item_1"><path d="M71.36,385L71.36,381.6L71.36,466"/><path class="fermaid-marker" d="M71.36,369L76.36,377L71.36,385L66.36,377Z" stroke-linejoin="round" fill="var(--_l)"/></g><g class="fermaid-edge fermaid-relation" data-id="id_Customer_Order_2"><path d="M71.36,177L71.36,302"/><path class="fermaid-marker" d="M71.36,309L68,301L74.72,301Z" fill="var(--_l)" stroke="none"/></g></g><g class="fermaid-edge-labels" font-size="14"><g class="fermaid-edge-label" data-id="id_Order_Item_1"><rect x="41.29" y="407" width="60.14" height="21" rx="3" fill="var(--_bg)"/><text x="71.36" y="422.4" text-anchor="middle">contains</text></g></g><g class="fer