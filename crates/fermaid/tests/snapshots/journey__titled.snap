<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-journey" viewBox="0 0 184 288" width="184" height="288" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_tw:var(--fermaid-title-weight,bold);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="journey"><text class="fermaid-title" font-weight="var(--_tw)" text-anchor="middle" xml:space="preserve"><tspan x="92" y="25.6">Day</tspan></text><path class="fermaid-grid" d="M26,128H176M26,154H176M26,180H176M26,206H176M26,232H176" fill="none" stroke="var(--_a)"/><g class="fermaid-scale" font-size="12" text-anchor="end" fill="var(--_m)"><text x="20" y="132.2">5</text><text x="20" y="158.2">4</text><text x="20" y="184.2">3</text><text x="20" y="210.2">2</text><text x="20" y="236.2">1</text></g><path class="fermaid-stems" d="M104,101V117" fill="none" stroke="var(--_b)" stroke-dasharray="2 3"/><g class="fermaid-face fermaid-face-happy" transform="translate(104,128)"><circle r="11" fill="var(--_bg)" stroke="var(--_l)"/><g fill="var(--_l)"><circle cx="-3.6" cy="-2.8" r="1.3"/><circle cx="3.6" cy="-2.8" r="1.3"/></g><path d="M-5,2A6,6 0 0 0 5,2" fill="none" stroke="var(--_l)" stroke-linecap="round"/></g><g class="fermaid-node fermaid-task" data-id="Make tea"><rect x="32" y="48" width="144" height="53" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text font-size="14" x="104" y="71.4" text-anchor="middle">Make tea</text><circle class="fermaid-actor" cx="104" cy="88" r="5" fill="var(--fermaid-series-1,#4c78