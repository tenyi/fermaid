<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-state" viewBox="0 0 427 261" width="427" height="261" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_tw:var(--fermaid-title-weight,bold);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="state"><text class="fermaid-title" font-weight="var(--_tw)" text-anchor="middle" xml:space="preserve"><tspan x="213.5" y="25.6">Choices</tspan></text><g transform="translate(0,36)"><g class="fermaid-edges" fill="none" stroke="var(--_l)" stroke-linecap="round"><g class="fermaid-edge fermaid-transition" data-id="edge0"><path d="M22,72L59,72"/><path class="fermaid-marker" d="M66,72L58,75.36L58,68.64Z" fill="var(--_l)" stroke="none"/></g><g class="fermaid-edge fermaid-transition" data-id="edge1"><path d="M166.46,72L203.46,72"/><path class="fermaid-marker" d="M210.46,72L202.46,75.36L202.46,68.64Z" fill="var(--_l)" stroke="none"/></g><g class="fermaid-edge fermaid-transition" data-id="edge2"><path d="M240.46,72C249.71,72 249.71,30 258.96,30L340.06,30"/><path class="fermaid-marker" d="M347.06,30L339.06,33.36L339.06,26.64Z" fill="var(--_l)" stroke="none"/></g><g class="fermaid-edge fermaid-transition" data-id="edge3"><path d="M240.46,72C249.71,72 249.71,114 258.96,114L347.06,114L343.34,114"/><path class="fermaid-marker" d="M350.34,114L342.34,117.36L342.34,110.64Z" fill="var(--_l)" stroke="none"/></g><g class="fermaid-edge fermaid-note-edge" stroke="var(--_b)" stroke-dasharray="3 4" data-id="True-True----note-4"><path d="M382.79,136L382.79,180"/></g></