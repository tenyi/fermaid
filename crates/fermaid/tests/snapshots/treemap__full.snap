---
<svg xmlns="http://www.w3.org/2000/svg" class="fermaid fermaid-treemap" viewBox="0 0 656 416" width="656" height="416" style="max-width:100%;height:auto;--_bg:var(--fermaid-bg,#fff);--_fg:var(--fermaid-fg,#1f1f1f);--_m:var(--fermaid-muted,#6e6e6e);--_l:var(--fermaid-line,#1f1f1f);--_s:var(--fermaid-surface,#f3f3f3);--_a:var(--fermaid-surface-alt,#e6e6e6);--_b:var(--fermaid-border,#8a8a8a);--_c:var(--fermaid-accent,#5b7bd5);color:var(--_fg);--_r:var(--fermaid-radius,4px);--_hw:var(--fermaid-heading-weight,bold);--_fm:var(--fermaid-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--fermaid-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="treemap"><g class="fermaid-sections" font-size="14"><g class="fermaid-node fermaid-section" data-id="Category B"><rect x="8" y="8" width="364" height="400" fill="var(--fermaid-series-2,#f58518)" fill-opacity="0.12" stroke="var(--fermaid-series-2,#f58518)" style="rx:var(--_r)"/><text x="16" y="27.9" font-weight="var(--_hw)">Category B</text><text class="fermaid-value" x="364" y="27.2" font-size="12" text-anchor="end" fill="var(--_m)">40</text></g><g class="fermaid-node fermaid-section" data-id="Category A"><rect x="376" y="8" width="272" height="400" fill="var(--fermaid-series-1,#4c78a8)" fill-opacity="0.12" stroke="var(--fermaid-series-1,#4c78a8)" style="rx:var(--_r)"/><text x="384" y="27.9" font-weight="var(--_hw)">Category A</text><text class="fermaid-value" x="640" y="27.2" font-size="12" text-anchor="end" fill="var(--_m)">30</text></g></g><g class="fermaid-leaves" text-anchor="middle" fill="var(--_bg)"><g class="fermaid-node fermaid-leaf" data-id="Item B2"><rect x="14" y="36" width="352" height="227" fill="var(--fermaid-series-2,#f58518)" style="rx:var(--_r)"/><text x="190" y="146.98" font-size="16">Item B2</text><text class="fermaid-value" x="190" y="164.05" font-size="13">25</text></g><g class="fermaid-